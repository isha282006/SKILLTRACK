# SkillTrack Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=skilltrack-super-secret-key-2026-secure-jwt-session

# Database Settings (Uncomment for MySQL)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/skilltrack_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skilltrack_db

# Default is SQLite for instant zero-configuration local demo:
DATABASE_URL=sqlite:///skilltrack.db

